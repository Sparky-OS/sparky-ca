#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=OFF -DBUILD_ED521_PROVIDER=OFF -DKDE_INSTALL_USE_QT_SYS_PATHS=ON

override_dh_auto_test:

override_dh_installdocs:
	dh_installdocs README.md DESIGN.md

override_dh_installsystemd:
	dh_installsystemd sparky-ca-update.timer

override_dh_installsystemduser:
	dh_installsystemduser sparky-ca-user-update.timer sparky-ca-user-update.path
