[Desktop Entry]
Version=1.0
Name=PJeOffice CA Certificates Installer
Name[pl_PL]=Instalator Certyfikatów PJeOffice CA
Name[pt_BR]=PJeOffice - Instalador de Certificados CA
GenericName=Certificate Manager
GenericName[pt_BR]=Gerenciador de certificados
Comment=PJeOffice CA Certificates Installer
Comment[pl_PL]=Instalator Certyfikatów PJeOffice CA
Comment[pt_BR]=PJeOffice - Instalador de Certificados CA
Exec=sparky-ca --gui %u
Icon=security-high
Terminal=false
Type=Application
Categories=Utility;Security;KDE;Qt;
MimeType=application/pkix-cert;application/x-x509-ca-cert;application/x-pem-file;application/x-pkcs7-certificates;application/x-pkcs12;
