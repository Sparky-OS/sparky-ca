[Desktop Entry]
Version=1.0
Name=PJeOffice CA Certificates Installer
GenericName=Certificate Manager
Comment=Manage ICP-Brasil certificates, browser trust and personal certificates
Keywords=certificate;ICP-Brasil;PJeOffice;CA;token;A1;A3;
Exec=sparky-ca --gui %u
Icon=security-high
Terminal=false
Type=Application
Categories=Utility;Security;KDE;Qt;
MimeType=application/pkix-cert;application/x-x509-ca-cert;application/x-pem-file;application/x-pkcs7-certificates;application/x-pkcs12;
